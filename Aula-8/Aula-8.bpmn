<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_RMA" targetNamespace="http://bpmn.io/schema/bpmn">
<bpmn:collaboration id="Collab_RMA">
<bpmn:participant id="P_cli" name="Cliente" processRef="Proc_cli"/>
<bpmn:participant id="P_multi" name="MULTCABOS (RMA)" processRef="Proc_multi"/>
<bpmn:messageFlow id="MF1" sourceRef="T_solicitar" targetRef="M_start"/>
<bpmn:messageFlow id="MF2" sourceRef="T_enviar" targetRef="T_receber"/>
<bpmn:messageFlow id="MF3" sourceRef="T_notificar" targetRef="T_decisao"/>
</bpmn:collaboration>
<bpmn:process id="Proc_cli" isExecutable="false">
<bpmn:startEvent id="S_cli" name="Defeito identificado"/>
<bpmn:task id="T_solicitar" name="Solicitar RMA"/>
<bpmn:task id="T_enviar" name="Enviar produto"/>
<bpmn:task id="T_decisao" name="Receber decisão"/>
<bpmn:endEvent id="E_cli" name="Atendimento encerrado"/>
<bpmn:sequenceFlow id="F1" sourceRef="S_cli" targetRef="T_solicitar"/>
<bpmn:sequenceFlow id="F2" sourceRef="T_solicitar" targetRef="T_enviar"/>
<bpmn:sequenceFlow id="F3" sourceRef="T_enviar" targetRef="T_decisao"/>
<bpmn:sequenceFlow id="F4" sourceRef="T_decisao" targetRef="E_cli"/>
</bpmn:process>
<bpmn:process id="Proc_multi" isExecutable="false">
<bpmn:laneSet id="LaneSet_multi">
<bpmn:lane id="L_at" name="Atendimento">
<bpmn:flowNodeRef>M_start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_registrar</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_receber</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_triar</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_defeito</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_recusar</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_emitir</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_notificar</bpmn:flowNodeRef>
<bpmn:flowNodeRef>E_fim</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="L_lab" name="Laboratório">
<bpmn:flowNodeRef>T_analisar</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_fork</bpmn:flowNodeRef>
<bpmn:flowNodeRef>T_laudo</bpmn:flowNodeRef>
<bpmn:flowNodeRef>G_join</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="M_start" name="Solicitação recebida"><bpmn:messageEventDefinition id="M_start_med"/></bpmn:startEvent>
<bpmn:task id="T_registrar" name="Registrar chamado"/>
<bpmn:task id="T_receber" name="Receber produto"/>
<bpmn:task id="T_triar" name="Triar produto"/>
<bpmn:exclusiveGateway id="G_defeito" name="Defeito confirmado?"/>
<bpmn:task id="T_recusar" name="Recusar garantia"/>
<bpmn:task id="T_emitir" name="Emitir nota de devolução"/>
<bpmn:task id="T_notificar" name="Notificar cliente"/>
<bpmn:endEvent id="E_fim" name="RMA concluído"/>
<bpmn:task id="T_analisar" name="Analisar defeito"/>
<bpmn:parallelGateway id="G_fork"/>
<bpmn:task id="T_laudo" name="Registrar laudo"/>
<bpmn:parallelGateway id="G_join"/>
<bpmn:sequenceFlow id="F5" sourceRef="M_start" targetRef="T_registrar"/>
<bpmn:sequenceFlow id="F6" sourceRef="T_registrar" targetRef="T_receber"/>
<bpmn:sequenceFlow id="F7" sourceRef="T_receber" targetRef="T_triar"/>
<bpmn:sequenceFlow id="F8" sourceRef="T_triar" targetRef="G_defeito"/>
<bpmn:sequenceFlow id="F9" sourceRef="G_defeito" targetRef="T_analisar"/>
<bpmn:sequenceFlow id="F10" sourceRef="G_defeito" targetRef="T_recusar"/>
<bpmn:sequenceFlow id="F11" sourceRef="T_analisar" targetRef="G_fork"/>
<bpmn:sequenceFlow id="F12" sourceRef="G_fork" targetRef="T_emitir"/>
<bpmn:sequenceFlow id="F13" sourceRef="G_fork" targetRef="T_laudo"/>
<bpmn:sequenceFlow id="F14" sourceRef="T_emitir" targetRef="G_join"/>
<bpmn:sequenceFlow id="F15" sourceRef="T_laudo" targetRef="G_join"/>
<bpmn:sequenceFlow id="F16" sourceRef="G_join" targetRef="T_notificar"/>
<bpmn:sequenceFlow id="F17" sourceRef="T_recusar" targetRef="T_notificar"/>
<bpmn:sequenceFlow id="F18" sourceRef="T_notificar" targetRef="E_fim"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_RMA"><bpmndi:BPMNPlane id="Plane_RMA" bpmnElement="Collab_RMA">
